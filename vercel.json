{
  "cleanUrls": true,
  "rewrites": [
    {"source":"/f","destination":"/api/for"},
    {"source":"/for","destination":"/api/for"},
    {"source":"/made","destination":"/"}
  ],
  "functions": {"api/for.js":{"includeFiles":"spiral.html"}},
  "headers": [
    {"source":"/spiral-audio-v1.mp3","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"}]}
  ]
}
